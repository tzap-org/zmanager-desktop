{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zmanager-desktop",
  "version": "1.2.4",
  "identifier": "org.tzap-org.zmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "ZManager",
        "width": 1280,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://ipc.localhost http://ipc.localhost http://localhost:* ws://localhost:*; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zmanager",
          "tzap"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "apk",
          "appx",
          "cbz",
          "epub",
          "ipa",
          "jar",
          "war",
          "xpi",
          "zip",
          "zipx"
        ],
        "name": "zip archive",
        "description": "zip archive",
        "role": "Viewer",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "7z",
          "cb7",
          "sevenz",
          "7z.001"
        ],
        "name": "sevenZip archive",
        "description": "sevenZip archive",
        "role": "Viewer",
        "mimeType": "application/x-7z-compressed"
      },
      {
        "ext": [
          "cbr",
          "rar"
        ],
        "name": "rar archive",
        "description": "rar archive",
        "role": "Viewer",
        "mimeType": "application/vnd.rar"
      },
      {
        "ext": [
          "cbt",
          "pax",
          "tar",
          "ustar"
        ],
        "name": "tar archive",
        "description": "tar archive",
        "role": "Viewer",
        "mimeType": "application/x-tar"
      },
      {
        "ext": [
          "gz",
          "tgz",
          "tar.gz"
        ],
        "name": "gzip archive",
        "description": "gzip archive",
        "role": "Viewer",
        "mimeType": "application/gzip"
      },
      {
        "ext": [
          "txz",
          "xz",
          "tar.xz"
        ],
        "name": "xz archive",
        "description": "xz archive",
        "role": "Viewer",
        "mimeType": "application/x-xz"
      },
      {
        "ext": [
          "zst"
        ],
        "name": "zstd archive",
        "description": "zstd archive",
        "role": "Viewer",
        "mimeType": "application/zstd"
      },
      {
        "ext": [
          "tzst",
          "tar.zst"
        ],
        "name": "tzst archive",
        "description": "tzst archive",
        "role": "Viewer",
        "mimeType": "application/x-zmanager-tzst"
      },
      {
        "ext": [
          "tzap",
          "vol000.tzap"
        ],
        "name": "tzap archive",
        "description": "tzap archive",
        "role": "Viewer",
        "mimeType": "application/x-zmanager-tzap"
      }
    ],
    "shortDescription": "Safe archive manager for Windows, Linux, and macOS",
    "longDescription": "ZManager is a safe archive manager backed by the ZManager Rust archive engine.",
    "windows": {
      "nsis": {
        "installerHooks": "../packaging/windows/nsis-context-menu.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "python3-nautilus"
        ],
        "desktopTemplate": "../packaging/linux/zmanager.desktop.hbs",
        "postInstallScript": "../packaging/linux/postinstall.sh",
        "postRemoveScript": "../packaging/linux/postremove.sh",
        "files": {
          "/usr/share/icons/hicolor/256x256/apps/zmanager-desktop.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/apps/zmanager-desktop.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/apps/zmanager-desktop.png": "icons/icon.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-zmanager-tzap.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-zmanager-tzap.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/mimetypes/application-x-zmanager-tzap.png": "icons/icon.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-zmanager-tzst.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-zmanager-tzst.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/mimetypes/application-x-zmanager-tzst.png": "icons/icon.png",
          "/usr/share/applications/zmanager-desktop.desktop": "../packaging/linux/zmanager-desktop.desktop",
          "/usr/share/metainfo/org.tzap-org.zmanager.desktop.metainfo.xml": "../packaging/linux/org.tzap-org.zmanager.desktop.metainfo.xml",
          "/usr/share/mime/packages/zmanager.xml": "../packaging/linux/xdg-mime.xml",
          "/usr/share/nautilus-python/extensions/zmanager_nautilus.py": "../packaging/linux/nautilus/zmanager_nautilus.py",
          "/usr/share/nautilus-python/extensions/zmanager_shell_actions_generated.py": "../packaging/linux/nautilus/zmanager_shell_actions_generated.py",
          "/usr/share/kio/servicemenus/zmanager-archive-servicemenu.desktop": "../packaging/linux/kde/zmanager-archive-servicemenu.desktop",
          "/usr/share/kio/servicemenus/zmanager-servicemenu.desktop": "../packaging/linux/kde/zmanager-servicemenu.desktop"
        }
      },
      "rpm": {
        "depends": [
          "nautilus-python"
        ],
        "desktopTemplate": "../packaging/linux/zmanager.desktop.hbs",
        "postInstallScript": "../packaging/linux/postinstall.sh",
        "postRemoveScript": "../packaging/linux/postremove.sh",
        "files": {
          "/usr/share/icons/hicolor/256x256/apps/zmanager-desktop.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/apps/zmanager-desktop.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/apps/zmanager-desktop.png": "icons/icon.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-zmanager-tzap.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-zmanager-tzap.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/mimetypes/application-x-zmanager-tzap.png": "icons/icon.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-zmanager-tzst.png": "icons/icon-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-zmanager-tzst.png": "icons/icon-512.png",
          "/usr/share/icons/hicolor/1024x1024/mimetypes/application-x-zmanager-tzst.png": "icons/icon.png",
          "/usr/share/applications/zmanager-desktop.desktop": "../packaging/linux/zmanager-desktop.desktop",
          "/usr/share/metainfo/org.tzap-org.zmanager.desktop.metainfo.xml": "../packaging/linux/org.tzap-org.zmanager.desktop.metainfo.xml",
          "/usr/share/mime/packages/zmanager.xml": "../packaging/linux/xdg-mime.xml",
          "/usr/share/nautilus-python/extensions/zmanager_nautilus.py": "../packaging/linux/nautilus/zmanager_nautilus.py",
          "/usr/share/nautilus-python/extensions/zmanager_shell_actions_generated.py": "../packaging/linux/nautilus/zmanager_shell_actions_generated.py",
          "/usr/share/kio/servicemenus/zmanager-archive-servicemenu.desktop": "../packaging/linux/kde/zmanager-archive-servicemenu.desktop",
          "/usr/share/kio/servicemenus/zmanager-servicemenu.desktop": "../packaging/linux/kde/zmanager-servicemenu.desktop"
        }
      }
    }
  }
}
