{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the main ZManager window to run archive commands and use native file dialogs/openers.",
  "windows": ["main"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "allow-healthcheck",
    "allow-project-contract",
    "allow-system-file-icons",
    "allow-default-handler-status",
    "allow-default-handler-set",
    "allow-default-handler-restore",
    "allow-validate-directory",
    "allow-record-diagnostic-event",
    "allow-diagnostic-log-info",
    "allow-quick-action-startup-state",
    "allow-native-frontend-ready",
    "allow-acknowledge-native-event",
    "allow-account-snapshot",
    "allow-account-begin-hosted-auth",
    "allow-account-apply-hosted-callback",
    "allow-account-complete-hosted-auth",
    "allow-account-enroll-certificate",
    "allow-account-renew-certificate",
    "allow-account-retire-device",
    "allow-account-fetch-current-user",
    "allow-account-forget",
    "allow-account-generate-recipient-key",
    "allow-account-generate-signing-identity",
    "allow-account-import-signing-identity",
    "allow-account-install-signing-certificate",
    "allow-account-remove-signing-identity",
    "allow-account-remove-recipient-key",
    "allow-account-set-default-signing-identity",
    "allow-account-remove-contact",
    "allow-account-inspect-contact-card",
    "allow-account-accept-contact-card",
    "allow-account-sync-contacts",
    "allow-start-archive-index",
    "allow-wait-archive-index",
    "allow-get-archive-children",
    "allow-search-archive-index",
    "allow-close-archive-index",
    "allow-plan-create",
    "allow-start-create",
    "allow-start-extract",
    "allow-verify-tzap-certificate",
    "allow-validate-tzap-signing-identity",
    "allow-start-native-file-drag",
    "allow-preview-entry",
    "allow-cleanup-preview-roots",
    "allow-test-archive",
    "allow-detect-archive-format",
    "allow-get-job-snapshot",
    "allow-subscribe-job-catalog",
    "allow-ack-subscription",
    "allow-unsubscribe-job",
    "allow-localsend-discover",
    "allow-enqueue-share",
    "allow-set-share-receiver",
    "allow-start-share",
    "allow-get-share-queue",
    "allow-skip-share",
    "allow-cancel-share",
    "allow-remove-share",
    "allow-localsend-respond-to-transfer",
    "allow-localsend-start-receiver",
    "allow-localsend-stop-receiver",
    "allow-localsend-list-trusted-devices",
    "allow-localsend-trust-device",
    "allow-localsend-untrust-device",
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-center",
    "core:window:allow-available-monitors",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-hide",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-scale-factor",
    "core:window:allow-set-focus",
    "core:window:allow-set-resizable",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "opener:allow-default-urls",
    "wdio:default",
    "wdio-webdriver:default"
  ]
}
