{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "disposable-task-window",
  "description": "Allow disposable task windows to receive job updates and control only their archive job.",
  "windows": ["task-*"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "allow-cancel-job",
    "allow-pause-job",
    "allow-resume-job",
    "allow-dismiss-job",
    "allow-start-extract",
    "allow-test-archive",
    "allow-accept-native-file-drag",
    "allow-start-native-file-drag",
    "allow-subscribe-job",
    "allow-ack-subscription",
    "allow-unsubscribe-job",
    "core:default",
    "wdio:default",
    "wdio-webdriver:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize"
  ]
}
