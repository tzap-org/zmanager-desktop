[Desktop Entry]
Categories={{categories}}
{{#if comment}}Comment={{comment}}{{/if}}
Exec={{exec}} %U
Icon={{icon}}
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar-compressed;application/x-tar;application/gzip;application/x-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/zstd;application/x-zmanager-tzst;application/x-zmanager-tzap;
Name=ZManager
StartupWMClass=zmanager-desktop
StartupNotify=true
Terminal=false
Type=Application
Actions=ExtractHere;ExtractToFolder;OpenArchive;AddToArchive;AddToTzap;AddToZip;AddToSevenZ;AddToTzst;AddToTgz;CompressShareOnLan;ShareOnLan;

[Desktop Action ExtractHere]
Name=Extract Here
Exec={{exec}} --quick-action extract-here --path %F
Icon={{icon}}

[Desktop Action ExtractToFolder]
Name=Extract to Archive Folder
Exec={{exec}} --quick-action extract-to-folder --path %f
Icon={{icon}}

[Desktop Action OpenArchive]
Name=Open archive
Exec={{exec}} --quick-action open --path %f
Icon={{icon}}

[Desktop Action AddToArchive]
Name=Add to archive...
Exec={{exec}} --quick-action compress --path %F
Icon={{icon}}

[Desktop Action AddToTzap]
Name=Add to .tzap
Exec={{exec}} --quick-action compress-tzap --path %F
Icon={{icon}}

[Desktop Action AddToZip]
Name=Add to .zip
Exec={{exec}} --quick-action compress-zip --path %F
Icon={{icon}}

[Desktop Action AddToSevenZ]
Name=Add to .7z
Exec={{exec}} --quick-action compress-7z --path %F
Icon={{icon}}

[Desktop Action AddToTzst]
Name=Add to .tzst
Exec={{exec}} --quick-action compress-tzst --path %F
Icon={{icon}}

[Desktop Action AddToTgz]
Name=Add to .tgz
Exec={{exec}} --quick-action compress-tgz --path %F
Icon={{icon}}

[Desktop Action CompressShareOnLan]
Name=Compress and Share on LAN
Exec={{exec}} --quick-action compress-share-on-lan --path %F
Icon={{icon}}

[Desktop Action ShareOnLan]
Name=Share on LAN
Exec={{exec}} --quick-action share-lan --path %f
Icon={{icon}}
